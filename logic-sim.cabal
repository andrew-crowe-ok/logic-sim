cabal-version:      3.0
name:               logicsim
version:            0.2.0.0
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        LogicSim.Core.Bit
        LogicSim.Core.Word8
        LogicSim.Core.Classes
        LogicSim.Core.Utils
        LogicSim.Combinational.Gates
        LogicSim.Combinational.Circuits
        LogicSim.Combinational.ALU
        LogicSim.Sequential.Memory
        LogicSim.Sequential.Machine
    build-depends:    base >= 4.14 && < 5, mtl >= 2.2
    hs-source-dirs:   src
    default-language: GHC2021

executable logic-sim
    import:           warnings
    main-is:          Main.hs
    other-modules:
        TUI
        TUI.State
        TUI.Update
        TUI.View
    build-depends:    base, logicsim, layoutz, terminal-size, mtl
    hs-source-dirs:   app
    default-language: GHC2021
    ghc-options:      -threaded

test-suite logic-sim-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >= 4.14 && < 5, logicsim
    default-language: GHC2021
    ghc-options:      -threaded
